          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "use-cases"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/projects",
              "concepts/data-connectors",
              "concepts/data-slices",
              "concepts/taxonomies-tags",
              "concepts/metadata",
              "concepts/destinations",
