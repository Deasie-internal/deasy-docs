{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Deasy Labs",
  "colors": {
    "primary": "#B7500C",
    "light": "#D67E43",
    "dark": "#8F3E08"
  },
  "favicon": "./images/deasy-mark.png",
  "fonts": {
    "heading": {
      "family": "Inter Variable",
      "source": "https://static.collibra.com/fonts/inter-latin-wght-normal.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Inter Variable",
      "source": "https://static.collibra.com/fonts/inter-latin-wght-normal.woff2",
      "format": "woff2"
    }
  },
  "background": {
    "color": {
      "light": "#F8F6F1",
      "dark": "#1D2227"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
